# Dry-run scanner defaults
MOMENTUM_QUERY=NBA
POLL_INTERVAL_MS=30000
MAX_ORDERS=3

# Polygon RPC used for live allowance checks and onboarding.
POLYGON_RPC_URL=https://polygon.drpc.org

# Live trading is opt-in. Keep real secrets in .env or .canon/wallet.env,
# never in this example file or committed docs.
# WALLET_PRIVATE_KEY=0x...
# WALLET_PROXY_ADDRESS=0x...

# Optional Polymarket service overrides for staging/debugging.
# POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com/
# POLYMARKET_CLOB_HOST=https://clob.polymarket.com
# CLOB_USER_AGENT=...
